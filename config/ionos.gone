package config

import (
	"bytes"
	"encoding/json"
	"fmt"
	"io"
	"net/http"
	"strings"
)

const (
	IonosBaseURL = "https://api.hosting.ionos.com/dns/v1"
)

type IonosRecord struct {
	Name     string `json:"name"`
	ID       string `json:"id,omitempty"`
	Type     string `json:"type"`
	Value    string `json:"content"`
	TTL      int    `json:"ttl"`
	Prio     int    `json:"prio"`
	Disabled bool   `json:"disabled"`
}

type IonosUpdate struct {
	Value    string `json:"content"`
	TTL      int    `json:"ttl"`
	Prio     int    `json:"prio"`
	Disabled bool   `json:"disabled"`
}

type IonosZone struct {
	Name    string        `json:"name"`
	ID      string        `json:"id"`
	Type    string        `json:"type"`
	Records []IonosRecord `json:"records"`
}

func (rec *IonosRecord) String() string {
	content, err := json.MarshalIndent(rec, "", "  ")
	if err != nil {
		return "failed to Marshal IonosRecord"
	}

	return string(content)
}

func (zone *IonosZone) String() string {
	content, err := json.MarshalIndent(zone, "", "  ")
	if err != nil {
		return "failed to Marshal IonosZone"
	}

	return string(content)
}

func (cfg *Config) IonosGetKey() string {
	for _, key := range cfg.API_Keys {
		if key.Name == "IONOS" {
			return key.Key + "." + key.Pswd
		}
	}

	return "" // key not found, will return error
}

func (cfg *Config) IonosUpdate(domain, typ, name, value string, prio int) (string, bool, error) {
	if cfg.SkipDNS {
		return "[SkipDNS] not setting for " + domain, false, nil
	}

	zoneID, err := cfg.IonosZoneID(domain)
	if err != nil {
		return "", false, err
	}

	// GET records
	url := IonosBaseURL + "/zones/" + zoneID
	data, err := cfg.IonosSend("GET", url, nil)
	if err != nil {
		return "", false, err
	}

	var zone IonosZone
	if err := json.Unmarshal(data, &zone); err != nil {
		return "", false, err
	}
	cfg.Debugf("IONOS-Zone: >%v<", zone.String())

	var id string
	if typ == "TXT" && strings.HasPrefix(value, "v=spf1") {
		for _, rec := range zone.Records {
			curr := IonosFormatValue(rec.Value)
			if typ == "TXT" && strings.HasPrefix(curr, "v=spf1") {
				if curr == value && rec.TTL == cfg.RegTTL {
					return fmt.Sprintf("✅ DNS (%s) %s for %s is '%s'", domain, typ, name, value), false, nil
				}
				id = rec.ID
				break
			}
		}
	} else {
		for _, rec := range zone.Records {
			curr := IonosFormatValue(rec.Value)
			if rec.Type == typ && rec.Name == name {
				if curr == value && rec.TTL == cfg.RegTTL {
					return fmt.Sprintf("✅ DNS (%s) %s for %s is '%s'", domain, typ, name, value), false, nil
				}
				id = rec.ID
				break
			}
		}
	}

	if id != "" {
		rec := IonosUpdate{
			Value:    value,
			TTL:      cfg.RegTTL,
			Prio:     prio,
			Disabled: false,
		}
		body, err := json.Marshal(rec)
		if err != nil {
			return "", false, err
		}
		url = IonosBaseURL + "/zones/" + zoneID + "/records/" + id
		_, err = cfg.IonosSend("PUT", url, body)
	} else {
		rec := IonosRecord{
			Name:     name,
			Type:     typ,
			Value:    value,
			TTL:      cfg.RegTTL,
			Prio:     prio,
			Disabled: false,
		}
		cfg.Debugf("New-Rec: >%v<", rec.String())
		body, err := json.Marshal([]IonosRecord{rec})
		if err != nil {
			return "", false, err
		}
		url = IonosBaseURL + "/zones/" + zoneID + "/records"
		_, err = cfg.IonosSend("POST", url, body)
	}

	if err != nil {
		return "", false, err
	}

	return fmt.Sprintf("updated: DNS (%s) %s for %s", domain, typ, name), true, nil
}

func (cfg *Config) IonosZoneID(domain string) (string, error) {
	url := IonosBaseURL + "/zones"
	data, err := cfg.IonosSend("GET", url, nil)
	if err != nil {
		return "", err
	}

	var zones []IonosZone
	if err := json.Unmarshal(data, &zones); err != nil {
		return "", err
	}

	for _, zone := range zones {
		if domain == zone.Name {
			return zone.ID, nil
		}
	}

	return "", fmt.Errorf("zone ID not found for domain %s", domain)
}

func (cfg *Config) IonosSend(method, url string, body []byte) ([]byte, error) {
	req, err := http.NewRequest(method, url, bytes.NewReader(body))
	if err != nil {
		return nil, err
	}
	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("X-API-Key", cfg.IonosGetKey())

	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		return nil, err
	}
	defer resp.Body.Close()

	data, err := io.ReadAll(resp.Body)
	if err != nil {
		return nil, err
	}
	cfg.Debugf("IonosSend (%s) >%s< =%d", method, url, resp.StatusCode)

	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		return nil, fmt.Errorf("HTTP %d: %s", resp.StatusCode, data)
	}

	return data, nil
}

func IonosFormatValue(value string) string {
	value = strings.ReplaceAll(value, `" "`, ``)
	value = strings.Trim(value, `"`)
	return value
}
