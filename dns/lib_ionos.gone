package dns

import (
	"context"
	"fmt"
	"net/netip"
	"sort"
	"strconv"
	"strings"
	"time"

	"github.com/libdns/ionos"
	"github.com/libdns/libdns"
)

type IonosProvider struct {
	AuthAPIToken string
	prov         *ionos.Provider
}

func NewIonosProvider(apiToken string) (*IonosProvider, error) {
	if strings.TrimSpace(apiToken) == "" {
		return nil, fmt.Errorf("ionos: api token required")
	}

	return &IonosProvider{
		AuthAPIToken: apiToken,
		prov:         &ionos.Provider{AuthAPIToken: apiToken},
	}, nil
}

func (p *IonosProvider) UpsertRRSet(ctx context.Context, zone string, rrIn RRSet) (string, error) {
	zone = normalizeZone(zone)

	rr, err := normalizeRRSet(rrIn)
	if err != nil {
		return "", err
	}

	if rr.Type == RR_CNAME && rr.Name == "@" {
		return "", fmt.Errorf("ionos: refusing CNAME at zone apex (@); use A/AAAA")
	}

	all, err := p.prov.GetRecords(ctx, zone)
	if err != nil {
		return "", fmt.Errorf("ionos: GetRecords failed for zone %s: %w", zone, err)
	}

	matching := filterMatchingRecords(all, rr)

	got, err := libdnsRecordsToRRStrings(rr.Type, matching)
	if err != nil {
		return "", err
	}
	want := append([]string(nil), rr.Records...) // already normalized by normalizeRRSet

	sortRRStrings(rr.Type, got)
	sortRRStrings(rr.Type, want)

	if equalRecords(got, want) {
		return fmt.Sprintf("✅ DNS (%s) no-op %s for %s: %v", zone, rr.Type, rr.Name, want), nil
	}

	desired, err := rrSetToLibdns(rr)
	if err != nil {
		return "", err
	}

	// Replace semantics: delete matching then append desired
	if len(matching) > 0 {
		del := makeDeleteMatchers(zone, rr, matching)
		fmt.Printf("ionos: deleting records: %q\n", del)
		if _, err := p.prov.DeleteRecords(ctx, zone, del); err != nil {
			return "", fmt.Errorf("ionos: DeleteRecords failed for %s %s.%s: %w", rr.Type, rr.Name, zone, err)
		}
	}

	if _, err := p.prov.AppendRecords(ctx, zone, desired); err != nil {
		return "", fmt.Errorf("ionos: AppendRecords failed for %s %s.%s: %w", rr.Type, rr.Name, zone, err)
	}

	action := "updated"
	if len(matching) == 0 {
		action = "created"
	}
	return fmt.Sprintf("✅ DNS (%s) %s %s for %s: %v", zone, action, rr.Type, rr.Name, want), nil
}

func filterMatchingRecords(all []libdns.Record, rr RRSet) []libdns.Record {
	wantName := rr.Name
	if wantName == "" {
		wantName = "@"
	}

	var out []libdns.Record
	for _, r := range all {
		base := r.RR()
		name := strings.TrimSpace(base.Name)
		if name == "" {
			name = "@"
		}
		if name != wantName {
			continue
		}

		switch rr.Type {
		case RR_A:
			if addr, ok := r.(libdns.Address); ok && addr.IP.IsValid() && addr.IP.Is4() {
				out = append(out, r)
			}
		case RR_AAAA:
			if addr, ok := r.(libdns.Address); ok && addr.IP.IsValid() && addr.IP.Is6() {
				out = append(out, r)
			}
		case RR_CNAME:
			if _, ok := r.(libdns.CNAME); ok {
				out = append(out, r)
			}
		case RR_MX:
			if _, ok := r.(libdns.MX); ok {
				out = append(out, r)
			}
		case RR_TXT:
			if _, ok := r.(libdns.TXT); ok {
				out = append(out, r)
			}
		case RR_CAA:
			if _, ok := r.(libdns.CAA); ok {
				out = append(out, r)
			}
		}
	}
	return out
}

func rrSetToLibdns(rr RRSet) ([]libdns.Record, error) {
	ttl := time.Duration(rr.TTL) * time.Second
	name := rr.Name
	if name == "" {
		name = "@"
	}

	switch rr.Type {
	case RR_A:
		var out []libdns.Record
		for _, ipStr := range rr.Records {
			ip, err := netip.ParseAddr(ipStr)
			if err != nil || !ip.Is4() {
				return nil, fmt.Errorf("ionos: invalid A record IP %q for %s", ipStr, rr.Name)
			}
			out = append(out, libdns.Address{Name: name, TTL: ttl, IP: ip})
		}
		return out, nil

	case RR_AAAA:
		var out []libdns.Record
		for _, ipStr := range rr.Records {
			ip, err := netip.ParseAddr(ipStr)
			if err != nil || !ip.Is6() {
				return nil, fmt.Errorf("ionos: invalid AAAA record IP %q for %s", ipStr, rr.Name)
			}
			out = append(out, libdns.Address{Name: name, TTL: ttl, IP: ip})
		}
		return out, nil

	case RR_CNAME:
		// normalizeRRSet guarantees exactly 1 record with trailing "."
		target := strings.TrimSuffix(rr.Records[0], ".")
		return []libdns.Record{
			libdns.CNAME{Name: name, TTL: ttl, Target: target},
		}, nil

	case RR_MX:
		var out []libdns.Record
		for _, s := range rr.Records {
			prio, host, err := ParseMX(s)
			if err != nil {
				return nil, err
			}
			host = strings.TrimSuffix(host, ".")
			out = append(out, libdns.MX{Name: name, TTL: ttl, Preference: uint16(prio), Target: host})
		}
		return out, nil

	case RR_TXT:
		var out []libdns.Record
		for _, txt := range rr.Records {
			out = append(out, libdns.TXT{Name: name, TTL: ttl, Text: txt})
		}
		return out, nil

	case RR_CAA:
		var out []libdns.Record
		for _, s := range rr.Records {
			flags, tag, value, err := parseCAA(s)
			if err != nil {
				return nil, err
			}
			out = append(out, libdns.CAA{Name: name, TTL: ttl, Flags: uint8(flags), Tag: tag, Value: value})
		}
		return out, nil
	}

	return nil, fmt.Errorf("ionos: unsupported rrset type %s", rr.Type)
}

func libdnsRecordsToRRStrings(typ RRSetType, recs []libdns.Record) ([]string, error) {
	var out []string

	switch typ {
	case RR_A:
		for _, r := range recs {
			addr, ok := r.(libdns.Address)
			if !ok || !addr.IP.IsValid() || !addr.IP.Is4() {
				continue
			}
			out = append(out, addr.IP.String())
		}
		return out, nil

	case RR_AAAA:
		for _, r := range recs {
			addr, ok := r.(libdns.Address)
			if !ok || !addr.IP.IsValid() || !addr.IP.Is6() {
				continue
			}
			out = append(out, addr.IP.String())
		}
		return out, nil

	case RR_CNAME:
		for _, r := range recs {
			cn, ok := r.(libdns.CNAME)
			if !ok {
				continue
			}
			t := strings.TrimSpace(cn.Target)
			if t == "" {
				continue
			}
			if !strings.HasSuffix(t, ".") {
				t += "."
			}
			out = append(out, t)
		}
		return out, nil

	case RR_MX:
		for _, r := range recs {
			mx, ok := r.(libdns.MX)
			if !ok {
				continue
			}
			host := strings.TrimSpace(mx.Target)
			if host == "" {
				continue
			}
			if !strings.HasSuffix(host, ".") {
				host += "."
			}
			out = append(out, fmt.Sprintf("%d %s", mx.Preference, host))
		}
		return out, nil

	case RR_TXT:
		for _, r := range recs {
			txt, ok := r.(libdns.TXT)
			if !ok {
				continue
			}
			out = append(out, txt.Text)
		}
		return out, nil

	case RR_CAA:
		for _, r := range recs {
			caa, ok := r.(libdns.CAA)
			if !ok {
				continue
			}
			val := caa.Value
			if strings.ContainsAny(val, " \t") && !(strings.HasPrefix(val, "\"") && strings.HasSuffix(val, "\"")) {
				val = strconv.Quote(val)
			}
			out = append(out, fmt.Sprintf("%d %s %s", caa.Flags, caa.Tag, val))
		}
		return out, nil
	}

	return nil, fmt.Errorf("ionos: unsupported rrset type %s", typ)
}

func sortRRStrings(typ RRSetType, records []string) {
	switch typ {
	case RR_MX:
		sort.Slice(records, func(i, j int) bool {
			pi, hi, _ := ParseMX(records[i])
			pj, hj, _ := ParseMX(records[j])
			if pi != pj {
				return pi < pj
			}
			return hi < hj
		})
	default:
		sort.Strings(records)
	}
}

// makeDeleteMatchers builds deletion inputs that are robust against TTL mismatches.
// DeleteRecords supports leaving Type/TTL/Value empty to match "any" for those fields,
// but Name must be present. We'll keep Name + Type and clear TTL/Value.
func makeDeleteMatchers(zone string, rr RRSet, matching []libdns.Record) []libdns.Record {
	name := rr.Name
	if name == "" {
		name = "@"
	}

	var out []libdns.Record
	switch rr.Type {
	case RR_A:
		// Delete any A at name
		out = append(out, libdns.RR{Name: name, Type: "A"})
	case RR_AAAA:
		out = append(out, libdns.RR{Name: name, Type: "AAAA"})
	case RR_CNAME:
		out = append(out, libdns.RR{Name: name, Type: "CNAME"})
	case RR_MX:
		out = append(out, libdns.RR{Name: name, Type: "MX"})
	case RR_TXT:
		out = append(out, libdns.RR{Name: name, Type: "TXT"})
	case RR_CAA:
		out = append(out, libdns.RR{Name: name, Type: "CAA"})
	default:
		// fallback: delete exactly what we matched (still ok)
		return matching
	}
	return out
}

func parseCAA(s string) (flags int, tag string, value string, err error) {
	parts := strings.Fields(s)
	if len(parts) < 3 {
		return 0, "", "", fmt.Errorf("invalid CAA record %q (want: \"<flags> <tag> <value>\")", s)
	}

	flags, err = strconv.Atoi(parts[0])
	if err != nil {
		return 0, "", "", fmt.Errorf("invalid CAA flags in %q: %w", s, err)
	}
	tag = parts[1]

	// Reconstruct value (may be quoted / contain spaces)
	rest := strings.TrimSpace(s)
	prefix := parts[0] + " " + parts[1] + " "
	if strings.HasPrefix(rest, prefix) {
		rest = strings.TrimSpace(rest[len(prefix):])
	} else {
		rest = strings.Join(parts[2:], " ")
	}
	rest = strings.TrimSpace(rest)

	if unq, err2 := strconv.Unquote(rest); err2 == nil {
		value = unq
	} else {
		value = rest
	}
	return flags, tag, value, nil
}
