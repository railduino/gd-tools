package utils

import (
	"bytes"
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"sort"
	"strings"
)

const (
	KeyListName = "key_list.json"
)

type Key struct {
	Name string `json:"name"`
	Mode string `json:"mode"`
	Key  string `json:"key"`
	Pswd string `json:"pswd"`
}

type KeyList struct {
	Entries []*Key `json:"entries"`
}

func LoadKeyList() (*KeyList, error) {
	var keyList KeyList

	content, err := os.ReadFile(KeyListName)
	if err != nil {
		if os.IsNotExist(err) {
			return &keyList, nil
		}
		return nil, fmt.Errorf("failed to read %s: %w", KeyListName, err)
	}

	if err := json.Unmarshal(content, &keyList); err != nil {
		return nil, fmt.Errorf("failed to unmarshal %s: %w", KeyListName, err)
	}

	return &keyList, nil
}

func GetKeyList() (*KeyList, error) {
	path := filepath.Join("..", KeyListName)

	content, err := os.ReadFile(path)
	if err != nil {
		return nil, fmt.Errorf("missing %s - are we in the correct dir?", path)
	}

	var keyList KeyList
	if err := json.Unmarshal(content, &keyList); err != nil {
		return nil, fmt.Errorf("failed to unmarshal %s: %w", path, err)
	}

	return &keyList, nil
}

func (list *KeyList) Validate(mode, name string) (bool, string) {
	var valid []string

	for _, entry := range list.Entries {
		if entry.Mode != mode {
			continue
		}
		if entry.Name == name {
			return true, ""
		}
		valid = append(valid, entry.Name)
	}

	return false, strings.Join(valid, " ")
}

func (list *KeyList) Save() error {
	sort.Slice(list.Entries, func(i, j int) bool {
		return list.Entries[i].Name < list.Entries[j].Name
	})

	content, err := json.MarshalIndent(list, "", "  ")
	if err != nil {
		return fmt.Errorf("failed to marshal %s: %w", KeyListName, err)
	}

	existing, err := os.ReadFile(KeyListName)
	if err == nil && bytes.Equal(existing, content) {
		return nil
	}

	if err := os.WriteFile(KeyListName, content, 0644); err != nil {
		return fmt.Errorf("failed to write %s: %w", KeyListName, err)
	}

	return nil
}

func (list *KeyList) Add(key *Key) error {
	if list == nil {
		return fmt.Errorf("nil KeyList")
	}
	if key == nil {
		return fmt.Errorf("nil Key")
	}
	if key.Name == "" {
		return fmt.Errorf("empty name")
	}

	for i, e := range list.Entries {
		if e.Name == key.Name {
			list.Entries[i].Key = key.Key
			list.Entries[i].Pswd = key.Pswd
			return list.Save()
		}
	}

	list.Entries = append(list.Entries, key)
	return list.Save()
}

func (list *KeyList) Delete(name string) error {
	if list == nil {
		return fmt.Errorf("nil KeyList")
	}
	if name == "" {
		return fmt.Errorf("empty name")
	}

	for i, e := range list.Entries {
		if e.Name == name {
			copy(list.Entries[i:], list.Entries[i+1:])
			list.Entries[len(list.Entries)-1] = nil
			list.Entries = list.Entries[:len(list.Entries)-1]
			return list.Save()
		}
	}

	return fmt.Errorf("key %q not found", name)
}
